# Local development settings, read by app/core/config.py when uvicorn runs from backend/.
# Copy to backend/.env.

# Public origin used to build short links
BASE_URL=http://localhost:8000

# Origins allowed to call the API from another port (the local static server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL installed on this machine
DATABASE_URL=postgresql+psycopg://shortener_user:shortener_password@localhost:5432/url_shortener

# Leave empty to disable caching when running locally without Redis
REDIS_URL=
CACHE_TTL_SECONDS=3600
